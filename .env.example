# Environment Variables — OtterBeer
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.

# ─── Database ───────────────────────────────────────────────────
# MongoDB connection string (Atlas or local)
# Example: mongodb+srv://user:password@cluster.mongodb.net/otter-beer
MONGODB_URI=

# ─── Vercel Blob Storage ─────────────────────────────────────────
# Get this from your Vercel project → Settings → Storage → Blob
# Required for image uploads (/api/upload)
BLOB_READ_WRITE_TOKEN=

# ─── Public Site URL ─────────────────────────────────────────────
# Base URL for generating canonical URLs and sitemap
# Dev: http://localhost:3000 | Prod: https://otterbeer.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Auth (Add when authentication is implemented) ───────────────
# Generate a secure secret: openssl rand -base64 32
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
