# Environment Variables — OtterBeer
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.

# ─── Database ───────────────────────────────────────────────────
# MongoDB connection string (Atlas or local)
# Example: mongodb+srv://user:password@cluster.mongodb.net/otter-beer
MONGODB_URI=

# ─── Public Site URL ─────────────────────────────────────────────
# Base URL for generating canonical URLs and sitemap
# Dev: http://localhost:3000 | Prod: https://otterbeer.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Auth (Google OAuth via Auth.js v5) ───────────────────────────
# Generate a secure secret: openssl rand -base64 32
AUTH_SECRET=
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#                           https://otterbeer.vn/api/auth/callback/google (prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The user allowlist starts empty (see docs/authentication.md). Set this to
# your own Google account email, run `pnpm run seed`, then sign in once —
# that first sign-in creates you as superAdmin. Safe to unset afterward.
FIRST_SUPER_ADMIN_EMAIL=

# ─── Cloudflare R2 (image storage) ────────────────────────────────
# Cloudflare dashboard → R2 → Manage API tokens
# Bucket is private; the app only ever hands out short-lived signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
